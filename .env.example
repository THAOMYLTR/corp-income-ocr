# Optional: only for running OUTSIDE Databricks. Copy to .env and fill in.
# On Databricks, set these in the notebook's settings cell instead (use dbutils.secrets).

# anthropic | openai | databricks
LLM_PROVIDER=anthropic
LLM_MODEL=

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=          # leave empty for api.anthropic.com

# LLM_PROVIDER=openai (OpenAI or any OpenAI-format gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM_PROVIDER=databricks (model serving endpoint; LLM_MODEL = endpoint name)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Tuning (defaults shown)
LLM_REQUESTS_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=120
MAX_WORKERS=3

# OCR
TESSERACT_CMD=               # empty = found on PATH (/usr/bin/tesseract on Databricks)
OCR_LANG=vie+eng
OCR_CACHE_DIR=               # empty = temp folder; set to a Volume to keep OCR between runs
PDF_TEXT_LAYER=1             # 0 = always OCR, even PDFs that already contain text
